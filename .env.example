# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file. See .gitignore.

# --- App ---
APP_ENV=development
TIMEZONE=Asia/Tashkent

# --- Data mode ---
# fixture = deterministic static sample data, no external credentials required
# live    = real external providers; fails clearly if credentials below are missing
DATA_MODE=fixture

# --- Backend ---
DATABASE_URL=sqlite:///./ai_irrigation.db
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Weather provider (Open-Meteo) — no API key required, live mode only ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Satellite provider (Copernicus Data Space Ecosystem / Sentinel Hub) ---
# See docs/api.md for the CDSE endpoint verification date. Never set real
# values in this file — only in your local, untracked .env.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_SH_BASE_URL=https://sh.dataspace.copernicus.eu
CDSE_CATALOG_URL=https://sh.dataspace.copernicus.eu/catalog/v1/search
CDSE_STATISTICS_URL=https://sh.dataspace.copernicus.eu/statistics/v1
CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1

# --- Satellite data-quality thresholds (live mode) ---
SATELLITE_LOOKBACK_DAYS=90
MIN_VALID_PIXEL_RATIO=0.60
MAX_SCENE_CLOUD_COVER=80
MAX_SATELLITE_OBSERVATION_AGE_DAYS=
TOKEN_EXPIRY_MARGIN_SECONDS=120

# --- Outbound HTTP client (both live providers) ---
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_BASE_DELAY_SECONDS=0.5
HTTP_RETRY_MAX_DELAY_SECONDS=8

# --- Provider response caching (in-memory MVP cache, live mode only) ---
WEATHER_CACHE_TTL_SECONDS=3600
SATELLITE_CACHE_TTL_SECONDS=3600

# --- Frontend (Vite) ---
VITE_API_BASE_URL=
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
