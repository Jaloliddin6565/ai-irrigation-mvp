# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file. See .gitignore.

# --- Data mode ---
# fixture = deterministic static sample data, no external credentials required
# live    = real external providers; fails clearly if credentials below are missing
DATA_MODE=fixture

# --- Backend ---
DATABASE_URL=
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=

# --- Weather provider (Open-Meteo) ---
OPEN_METEO_BASE_URL=

# --- Satellite provider (Copernicus Data Space Ecosystem / Sentinel Hub) ---
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_IDENTITY_TOKEN_URL=
CDSE_SH_BASE_URL=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
